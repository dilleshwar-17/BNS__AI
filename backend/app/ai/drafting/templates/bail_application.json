{
  "template": "bail_application",
  "title": "Bail Application (Regular)",
  "category": "criminal",
  "description": "Apply for regular bail under BNSS Section 478",
  "version": "1.0",
  "estimated_time": "6-8 min",
  "sections": [
    {
      "id": "court",
      "title": "Court & Case Details",
      "description": "Which court has jurisdiction?",
      "fields": [
        {"key": "court_name", "label": "Name of Court", "type": "text", "required": true, "placeholder": "e.g. Sessions Court, Tis Hazari, Delhi"},
        {"key": "case_no", "label": "Case Number (if known)", "type": "text", "required": false},
        {"key": "crime_number", "label": "Crime Number", "type": "text", "required": false},
        {"key": "fir_number", "label": "FIR Number", "type": "text", "required": true},
        {"key": "police_station", "label": "Police Station", "type": "text", "required": true, "placeholder": "Where FIR was registered"},
        {"key": "applicable_sections", "label": "Applicable BNS Sections", "type": "text", "required": true, "placeholder": "e.g. 302, 307, 379 BNS"}
      ]
    },
    {
      "id": "applicant",
      "title": "Applicant / Accused Details",
      "description": "Who is seeking bail?",
      "fields": [
        {"key": "applicant_name", "label": "Full Name of Applicant", "type": "text", "required": true},
        {"key": "father_name", "label": "Father's Name", "type": "text", "required": false},
        {"key": "age", "label": "Age (years)", "type": "number", "required": false},
        {"key": "occupation", "label": "Occupation", "type": "text", "required": false},
        {"key": "address", "label": "Address", "type": "textarea", "required": true},
        {"key": "gender", "label": "Gender", "type": "select", "required": false, "options": ["Male", "Female", "Other"]}
      ]
    },
    {
      "id": "grounds",
      "title": "Arrest & Grounds for Bail",
      "description": "Why should bail be granted?",
      "fields": [
        {"key": "arrest_date", "label": "Date of Arrest / Judicial Custody", "type": "date", "required": true},
        {"key": "grounds_for_bail", "label": "Detailed Grounds for Bail", "type": "textarea", "required": true, "placeholder": "Explain why bail should be granted (e.g. false implication, investigation complete, permanent resident, no flight risk, no tampering)...", "validation": {"min_length": 40}},
        {"key": "medical_conditions", "label": "Medical Conditions (if any)", "type": "textarea", "required": false, "placeholder": "Any serious medical conditions requiring release"},
        {"key": "previous_criminal_record", "label": "Previous Criminal Record (if any)", "type": "textarea", "required": false, "placeholder": "Details of previous cases, if any"},
        {"key": "surety_name", "label": "Surety Name (if available)", "type": "text", "required": false},
        {"key": "surety_details", "label": "Surety Address & Details", "type": "textarea", "required": false}
      ]
    }
  ],
  "conditionals": [
    {"field": "medical_grounds", "label": "Are you seeking bail on medical grounds?", "type": "boolean", "required": false, "show_fields": ["medical_hospital", "medical_diagnosis", "medical_certificate"]},
    {"field": "medical_hospital", "label": "Hospital / Doctor", "type": "text", "required": false, "condition": "medical_grounds"},
    {"field": "medical_diagnosis", "label": "Diagnosis", "type": "textarea", "required": false, "condition": "medical_grounds"},
    {"field": "medical_certificate", "label": "Medical Certificate Available?", "type": "boolean", "required": false, "condition": "medical_grounds"},
    {"field": "is_female", "label": "Is the applicant female?", "type": "boolean", "required": false, "show_fields": ["pregnant", "dependent_children"]},
    {"field": "pregnant", "label": "Is the applicant pregnant?", "type": "boolean", "required": false, "condition": "is_female"},
    {"field": "dependent_children", "label": "Has dependent children?", "type": "textarea", "required": false, "condition": "is_female", "placeholder": "Details of dependent children"}
  ],
  "output_structure": [
    "Court Heading",
    "Case Details",
    "Applicant Details",
    "Facts of the Case",
    "Grounds for Bail",
    "Applicable Law",
    "Undertaking",
    "Prayer",
    "Verification",
    "Advocate Signature"
  ],
  "retrieval_config": {"statutes": ["BNS", "BNSS"], "max_results": 5, "relevance_threshold": 0.6},
  "prompt_instructions": "Draft a regular bail application under BNSS Section 478. Include court heading, case details, applicant information, facts, grounds, applicable legal provisions, undertaking, and prayer. Use professional legal language.",
  "export_settings": {"formats": ["docx", "pdf", "txt", "markdown"], "font": "Times New Roman", "font_size": 12}
}
