{
  "template": "fir",
  "title": "First Information Report (FIR)",
  "category": "criminal",
  "description": "File a criminal complaint with the police under BNSS Section 173",
  "version": "1.0",
  "estimated_time": "5-7 min",
  "sections": [
    {
      "id": "complainant",
      "title": "Complainant Details",
      "description": "Who is reporting the incident?",
      "fields": [
        {"key": "complainant_name", "label": "Full Name of Informant", "type": "text", "required": true, "placeholder": "e.g. Rajesh Kumar", "validation": {"min_length": 3}},
        {"key": "father_name", "label": "Father's / Mother's / Spouse Name", "type": "text", "required": false, "placeholder": "e.g. Suresh Kumar"},
        {"key": "age", "label": "Age (years)", "type": "number", "required": false, "placeholder": "e.g. 35"},
        {"key": "occupation", "label": "Occupation", "type": "text", "required": false, "placeholder": "e.g. Business, Employee"},
        {"key": "complainant_address", "label": "Residential Address", "type": "textarea", "required": true, "placeholder": "Full address with street, city, PIN"},
        {"key": "contact_no", "label": "Mobile Number", "type": "phone", "required": true, "placeholder": "e.g. 9876543210"},
        {"key": "email", "label": "Email (optional)", "type": "email", "required": false}
      ]
    },
    {
      "id": "incident",
      "title": "Incident Details",
      "description": "When and where did the incident occur?",
      "fields": [
        {"key": "incident_date", "label": "Date of Incident", "type": "date", "required": true},
        {"key": "incident_time", "label": "Time of Incident", "type": "text", "required": false, "placeholder": "e.g. 3:30 PM"},
        {"key": "incident_place", "label": "Place of Occurrence", "type": "textarea", "required": true, "placeholder": "Full address/location of incident"},
        {"key": "police_station", "label": "Police Station", "type": "text", "required": true, "placeholder": "Under whose jurisdiction?"},
        {"key": "district", "label": "District", "type": "text", "required": false},
        {"key": "state", "label": "State", "type": "text", "required": false}
      ]
    },
    {
      "id": "offense",
      "title": "Offence Details",
      "description": "Describe the incident and suspected offence",
      "fields": [
        {"key": "description", "label": "Detailed Description of Incident", "type": "textarea", "required": true, "placeholder": "Describe the incident chronologically in detail...", "validation": {"min_length": 30}},
        {"key": "suspected_offence", "label": "Suspected Offence / Sections", "type": "text", "required": false, "placeholder": "e.g. Theft, Assault — BNS Sections if known"},
        {"key": "accused_name", "label": "Name of Accused (if known)", "type": "text", "required": false, "placeholder": "Comma-separated names"},
        {"key": "accused_description", "label": "Description of Accused (if name not known)", "type": "textarea", "required": false, "placeholder": "Height, build, clothing, identifying features"},
        {"key": "number_of_accused", "label": "Number of Accused", "type": "number", "required": false}
      ]
    }
  ],
  "conditionals": [
    {"field": "property_involved", "label": "Was any property stolen/damaged?", "type": "boolean", "required": false, "show_fields": ["property_type", "property_brand", "property_model", "property_serial", "property_value"]},
    {"field": "property_type", "label": "Type of Property", "type": "text", "required": false, "condition": "property_involved"},
    {"field": "property_brand", "label": "Brand (if applicable)", "type": "text", "required": false, "condition": "property_involved"},
    {"field": "property_model", "label": "Model (if applicable)", "type": "text", "required": false, "condition": "property_involved"},
    {"field": "property_serial", "label": "IMEI / Serial Number", "type": "text", "required": false, "condition": "property_involved"},
    {"field": "property_value", "label": "Estimated Value (Rs.)", "type": "number", "required": false, "condition": "property_involved"},
    {"field": "witness_available", "label": "Are there any witnesses?", "type": "boolean", "required": false, "show_fields": ["witness_name", "witness_contact", "witness_address"]},
    {"field": "witness_name", "label": "Witness Name(s)", "type": "text", "required": false, "condition": "witness_available"},
    {"field": "witness_contact", "label": "Witness Contact", "type": "phone", "required": false, "condition": "witness_available"},
    {"field": "witness_address", "label": "Witness Address", "type": "textarea", "required": false, "condition": "witness_available"}
  ],
  "output_structure": [
    "Police Station Header",
    "FIR Number",
    "Complainant Details",
    "Incident Narrative",
    "Offence Description",
    "Accused Details",
    "Witness Details",
    "Property Details",
    "Prayer",
    "Signature",
    "Verification"
  ],
  "retrieval_config": {"statutes": ["BNS"], "max_results": 5, "relevance_threshold": 0.6},
  "prompt_instructions": "Draft a complete First Information Report under BNSS Section 173. Follow Indian police FIR format. Include all details provided.",
  "export_settings": {"formats": ["docx", "pdf", "txt", "markdown"], "font": "Times New Roman", "font_size": 12}
}
