{
  "template": "anticipatory_bail",
  "title": "Anticipatory Bail Application",
  "category": "criminal",
  "description": "Apply for pre-arrest bail under BNSS Section 482",
  "version": "1.0",
  "estimated_time": "6-8 min",
  "sections": [
    {
      "id": "court",
      "title": "Court Details",
      "description": "Jurisdiction",
      "fields": [
        {"key": "court_name", "label": "Name of Court", "type": "text", "required": true, "placeholder": "e.g. Sessions Court, Tis Hazari, Delhi"},
        {"key": "case_no", "label": "Case / Complaint Number (if any)", "type": "text", "required": false}
      ]
    },
    {
      "id": "applicant",
      "title": "Applicant Details",
      "description": "Who is seeking anticipatory bail?",
      "fields": [
        {"key": "applicant_name", "label": "Full Name", "type": "text", "required": true},
        {"key": "father_name", "label": "Father's Name", "type": "text", "required": false},
        {"key": "age", "label": "Age (years)", "type": "number", "required": false},
        {"key": "occupation", "label": "Occupation", "type": "text", "required": false},
        {"key": "address", "label": "Address", "type": "textarea", "required": true}
      ]
    },
    {
      "id": "case_details",
      "title": "FIR / Case Details",
      "description": "Details of anticipated arrest",
      "fields": [
        {"key": "fir_number", "label": "FIR Number (if registered)", "type": "text", "required": false},
        {"key": "police_station", "label": "Police Station", "type": "text", "required": true},
        {"key": "offense_sections", "label": "Offence Sections Alleged", "type": "text", "required": true, "placeholder": "e.g. 406, 420 BNS"},
        {"key": "facts", "label": "Brief Facts of the Case", "type": "textarea", "required": true, "validation": {"min_length": 30}},
        {"key": "grounds", "label": "Grounds for Anticipatory Bail", "type": "textarea", "required": true, "placeholder": "Why should pre-arrest bail be granted?", "validation": {"min_length": 40}},
        {"key": "arrest_apprehension", "label": "Reason to Apprehend Arrest", "type": "textarea", "required": true, "placeholder": "Why do you believe arrest is imminent?"}
      ]
    }
  ],
  "conditionals": [],
  "output_structure": [
    "Court Heading",
    "Applicant Details",
    "Facts of the Case",
    "Grounds for Anticipatory Bail",
    "Applicable Law",
    "Undertaking",
    "Prayer",
    "Verification",
    "Advocate Signature"
  ],
  "retrieval_config": {"statutes": ["BNS", "BNSS"], "max_results": 5, "relevance_threshold": 0.6},
  "prompt_instructions": "Draft an anticipatory bail application under BNSS Section 482. Include court heading, applicant details, facts, grounds for pre-arrest bail, applicable law, undertaking, and prayer.",
  "export_settings": {"formats": ["docx", "pdf", "txt", "markdown"], "font": "Times New Roman", "font_size": 12}
}
