# Copy to .env and adjust for your environment. Never commit .env.
#
# Application
APP_NAME=BNS AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://bnsai:bnsai_secret@localhost:5432/bnsai
POOL_SIZE=10
MAX_OVERFLOW=20

# Redis 7
REDIS_URL=redis://localhost:6379/0

# Neo4j 5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bnsai_neo4j

# ChromaDB 0.5
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_TOKEN=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Gemini (optional, for cloud inference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# JWT — generate a strong secret:  openssl rand -base64 32
SECRET_KEY=change_me_generate_with_openssl_rand_base64_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8003
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_WINDOW_SECONDS=60

# RAG
RAG_TOP_K=20
RAG_RERANK_TOP_K=6
RAG_MIN_SCORE=0.35

# Agents
MAX_AGENT_STEPS=5
MAX_RETRIEVAL_ROUNDS=2
AGENT_TIMEOUT_SECONDS=30.0

# Voice
STT_PROVIDER=none
TTS_PROVIDER=none

# Caching
LLM_CACHE_TTL=300
VECTOR_CACHE_TTL=600
